# Supply-chain: block arbitrary dependency lifecycle scripts (preinstall/
# install/postinstall) — a major npm attack vector. This toolchain builds
# (tsup), type-checks (tsc), tests (vitest) and lints (biome) with no dep
# install scripts, so this is safe here.
ignore-scripts=true
# Reproducible installs: refuse to run on an unsupported engine and pin
# exact versions on save.
engine-strict=true
save-exact=true
