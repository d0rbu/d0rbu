{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d0rbu.github.io/d0rbu/data/card.schema.json",
  "title": "henry-castillo card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "projects", "resume", "demos"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 2 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "handle", "tagline", "about", "email", "links"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "handle": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "about": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github", "blog", "twitter"],
          "properties": {
            "github": { "type": "string", "minLength": 1 },
            "blog": { "type": "string" },
            "twitter": { "type": "string" }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "blurb", "url", "tags"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "blurb": { "type": "string" },
          "url": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf", "experience", "education", "highlights"],
      "properties": {
        "pdf": { "type": "string" },
        "experience": { "type": "array", "items": { "type": "object" } },
        "education": { "type": "array", "items": { "type": "object" } },
        "highlights": { "type": "array", "items": { "type": "string" } }
      }
    },
    "demos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "summary", "min_version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "min_version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
